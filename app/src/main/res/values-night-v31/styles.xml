<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/nisaa_cream</item>
        <item name="android:navigationBarColor">@color/nisaa_cream</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/nisaa_rose</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowSplashScreenBackground">@color/nisaa_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_nisaa_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/nisaa_rose_soft</item>
    </style>
    <style name="AppTheme.Splash" parent="AppTheme">
        <item name="android:windowSplashScreenBackground">@color/nisaa_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_nisaa_mark</item>
    </style>
</resources>
